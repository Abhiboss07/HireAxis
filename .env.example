# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. .env is gitignored.
# In production, set these in Vercel > Project Settings > Environment Variables.
# ---------------------------------------------------------------------------

# Google Apps Script Web App URL for Google Sheets storage.
# Used by both the /contact page form and the landing popup form.
VITE_GOOGLE_SHEET_URL=https://script.google.com/macros/s/AKfycbxYR01lTGqX28y0VmKL80AItgTYOLcFeOmpuG5NOnvDPIPivMoqr4aP1Yz05fgVGnB4/exec
# Razorpay publishable Key ID. Safe to expose in the browser.
# Read by /api/create-order and returned to the browser with each order, so it
# is never baked into the bundle at build time.
# Test keys start with rzp_test_, live keys with rzp_live_.
VITE_RAZORPAY_KEY_ID=rzp_test_TAVtNejxKxFUnf

# Razorpay Key Secret. SERVER ONLY - no VITE_ prefix, so Vite will never
# inline it into client code. Used by /api/create-order and /api/verify-payment.
RAZORPAY_KEY_SECRET=CKQhNN7mUmqzZLEerBF7jNgu
